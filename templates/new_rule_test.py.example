import tempfile
import unittest
from pathlib import Path

from repositories.json_scoreboard_repository import JsonScoreboardRepository
from services.game_service import GameService


class MemoryRepository:
    def __init__(self):
        self.saved_state = None

    def load(self):
        return self.saved_state

    def save(self, state):
        self.saved_state = state


class NewRuleTests(unittest.TestCase):
    def setUp(self):
        self.temporary_folder = tempfile.TemporaryDirectory()
        self.scoreboard = JsonScoreboardRepository(Path(self.temporary_folder.name) / "scoreboard.json")
        self.game = GameService(MemoryRepository(), self.scoreboard)
        self.state = self.game.start_new_game()

    def tearDown(self):
        self.temporary_folder.cleanup()

    def test_your_new_rule_in_normal_case(self):
        # 1. 準備資料
        # 2. 呼叫 GameService 的公開方法
        # 3. 比對你期待的 State 或回饋
        self.fail("請將這個模板改成真正的測試")

    def test_your_new_rule_does_not_break_scoreboard(self):
